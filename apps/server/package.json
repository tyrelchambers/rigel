{
  "name": "@rigel/server",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --external:node-pty --outfile=dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/lib-storage": "^3.1126.0",
    "@hono/node-server": "latest",
    "@rigel/catalog": "workspace:*",
    "@rigel/cloud-connect": "workspace:*",
    "@rigel/k8s": "workspace:*",
    "date-fns": "^4.4.0",
    "hono": "latest",
    "livekit-server-sdk": "^2.17.0",
    "node-pty": "1.1.0",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/ws": "latest",
    "esbuild": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.8"
  }
}
