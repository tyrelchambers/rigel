---
import DownloadCta from "./DownloadCta.astro";
---

<section
    id="cta"
    class="chart-grid relative overflow-hidden border-t border-line-subtle bg-surface-sunken"
>
    <div
        class="relative mx-auto flex max-w-[820px] flex-col items-center px-6 py-28 text-center sm:px-8 lg:py-36"
    >
        <h2
            data-reveal
            class="ink-gradient text-[clamp(3rem,12vw,6.5rem)] font-bold leading-none tracking-[-0.04em]"
        >
            Skip the ops team.
        </h2>

        <p
            data-reveal
            style="--reveal-delay:100ms"
            class="mt-6 max-w-[620px] text-[16.5px] leading-relaxed text-fg-secondary"
        >
            Download Rigel and connect your first cluster in a couple of
            minutes. Free while in beta.
        </p>

        <div
            data-reveal
            style="--reveal-delay:180ms"
            class="mt-9 flex w-full flex-col items-center gap-4"
        >
            <DownloadCta showChips={false} showMeta={false} />
            <p class="flex items-center gap-2 text-[13.5px] text-fg-secondary">
                Windows and Linux
                <span aria-hidden="true" class="text-fg-tertiary">·</span>
                <a
                    href="/download"
                    class="font-medium text-accent transition-colors hover:text-accent-hover"
                >
                    All downloads ↗
                </a>
            </p>
        </div>
    </div>
</section>
