# Env for running the `api` service locally (Stripe / entitlements / sign-in).
# Copy to .env and fill in TEST-mode Stripe values. See docs/stripe-setup.md.

# Shared Postgres on the remote node, database `rigel`.
DATABASE_URL=postgres://rigel:rigel@100.85.103.61:5432/rigel?sslmode=disable
APP_KEY=devkey

# Must equal the desktop's RIGEL_SIGNUP_ENDPOINT so the app recognizes the
# post-checkout redirect (Stripe returns to ${BILLING_ENDPOINT}/billing/complete).
BILLING_ENDPOINT=http://localhost:8080

STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
RIGEL_FREE_BETA=1

# Needed for passwordless sign-in codes.
RESEND_API_KEY=
RESEND_FROM=Rigel <login@rigel.run>
