{
  "name": "rigel-assistant-agent",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "In-cluster autonomous remediation agent for Rigel. Detects incidents, has Claude diagnose them, and auto-remediates the safe tier under deterministic guardrails.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "yaml": "^2.9.0"
  }
}
